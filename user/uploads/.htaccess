# Uploads are served as static files only. Never execute scripts from here.
Options -Indexes -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .phar
<FilesMatch "\.(php|phtml|phar|php[0-9]|cgi|pl|py|sh)$">
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
</FilesMatch>
