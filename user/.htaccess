# user/ holds data, not public code. Static files in uploads/ and theme assets stay reachable;
# PHP files anywhere below user/ are never served directly.
Options -Indexes
<FilesMatch "\.(php|phtml|phar|php[0-9])$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
